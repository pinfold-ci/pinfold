{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pinfold-ci/pinfold/schema/pinfold.schema.json",
  "title": "pinfold.yml (spec version 0)",
  "description": "Editor support only. The pinfold compiler is the authority: run `pinfold validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflows"
  ],
  "properties": {
    "version": {
      "const": 0
    },
    "workflows": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "not": {
          "pattern": "\\$\\{\\{"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "jobs"
      ],
      "properties": {
        "on": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "push": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "branches": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "schedule": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "cron": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "not": {
                        "pattern": "\\$\\{\\{"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "pattern": "\\$\\{\\{"
                        }
                      },
                      "minItems": 1
                    }
                  ]
                }
              }
            },
            "manual": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {}
            },
            "issue_comment": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "issues": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_target": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "branches": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_review": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_review_comment": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "discussion": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "discussion_comment": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            }
          }
        },
        "jobs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/job"
          }
        },
        "unsafe_run": {
          "type": "boolean"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "steps"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        "needs": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "if": {
          "$ref": "#/$defs/condition"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "artifact-metadata": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "attestations": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "checks": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "code-quality": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "contents": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "copilot-requests": {
              "enum": [
                "write",
                "none"
              ]
            },
            "deployments": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "discussions": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "id-token": {
              "enum": [
                "write",
                "none"
              ]
            },
            "issues": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "packages": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "pages": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "pull-requests": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "security-events": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "statuses": {
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "vulnerability-alerts": {
              "enum": [
                "read",
                "none"
              ]
            }
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        "timeout-minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "cancel-in-progress": {
              "type": "boolean"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "produces": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\$\\{\\{"
            }
          }
        },
        "consumes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              }
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkout"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "checkout": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "run": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "env": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uses"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "uses": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+(/[A-Za-z0-9._/-]+)?@[A-Za-z0-9._/+-]+$",
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "body"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "const": "comment"
            },
            "target": {
              "$ref": "#/$defs/value"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "sticky": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "labels",
            "allowed"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "const": "add_labels"
            },
            "target": {
              "$ref": "#/$defs/value"
            },
            "labels": {
              "$ref": "#/$defs/labels"
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "labels"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "const": "remove_labels"
            },
            "target": {
              "$ref": "#/$defs/value"
            },
            "labels": {
              "$ref": "#/$defs/labels"
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "sha",
            "state",
            "context"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "const": "commit_status"
            },
            "sha": {
              "$ref": "#/$defs/value"
            },
            "state": {
              "enum": [
                "error",
                "failure",
                "pending",
                "success"
              ]
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "tag"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "const": "release"
            },
            "tag": {
              "$ref": "#/$defs/value"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "generate_notes": {
              "type": "boolean"
            },
            "draft": {
              "type": "boolean"
            },
            "prerelease": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "context": {
              "enum": [
                "actor",
                "triggering_actor",
                "commit.sha",
                "comment.body",
                "comment.id",
                "event.name",
                "issue.number",
                "issue.title",
                "issue.body",
                "pr.number",
                "pr.title",
                "pr.body",
                "pr.author_association",
                "pr.head.ref",
                "pr.head.sha",
                "pr.base.ref",
                "ref.name",
                "repo.full_name",
                "repo.default_branch",
                "run.id",
                "run.attempt"
              ]
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "var": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "output": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        }
      ]
    },
    "labels": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "minItems": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_comment_args"
          ],
          "properties": {
            "from_comment_args": {
              "const": true
            }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "event": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "branch": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "tag": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "label": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "actor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "association": {
          "oneOf": [
            {
              "enum": [
                "COLLABORATOR",
                "CONTRIBUTOR",
                "FIRST_TIMER",
                "FIRST_TIME_CONTRIBUTOR",
                "MANNEQUIN",
                "MEMBER",
                "NONE",
                "OWNER"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "COLLABORATOR",
                  "CONTRIBUTOR",
                  "FIRST_TIMER",
                  "FIRST_TIME_CONTRIBUTOR",
                  "MANNEQUIN",
                  "MEMBER",
                  "NONE",
                  "OWNER"
                ]
              }
            }
          ]
        },
        "status": {
          "enum": [
            "always",
            "failure",
            "not_cancelled",
            "success"
          ]
        },
        "comment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts_with"
          ],
          "properties": {
            "starts_with": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        "maintainer": {
          "const": true
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    }
  }
}
