{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pinfold-ci/pinfold/schema/pinfold.schema.json",
  "title": "pinfold.yml (spec version 0)",
  "description": "Editor support only. The pinfold compiler is the authority: run `pinfold validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflows"
  ],
  "properties": {
    "version": {
      "description": "Spec format version. Only 0 exists.",
      "const": 0
    },
    "workflows": {
      "description": "Workflows to generate, by name. Each one becomes .github/workflows/pinfold-<name>.yml.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "not": {
          "pattern": "\\$\\{\\{"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "workflow": {
      "description": "One workflow: its triggers and jobs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "jobs"
      ],
      "properties": {
        "on": {
          "description": "Triggers. push, schedule and manual are trusted: jobs may run your scripts. Every other trigger is privileged: every job holds credentials and may only use effects and reviewed actions (design \u00a74).",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "push": {
              "description": "Trusted: a push to matching branches or tags.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "branches": {
                  "description": "Branch name patterns, e.g. [main].",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "tags": {
                  "description": "Tag name patterns, e.g. [\"v*\"].",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "paths": {
                  "description": "Only run when a changed file matches one of these path patterns.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "schedule": {
              "description": "Trusted: run on a cron schedule.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "cron": {
                  "description": "A cron expression in UTC, or a list of them, e.g. \"17 3 * * 1\".",
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "not": {
                        "pattern": "\\$\\{\\{"
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "not": {
                          "pattern": "\\$\\{\\{"
                        }
                      },
                      "minItems": 1
                    }
                  ]
                }
              }
            },
            "manual": {
              "description": "Trusted: run by hand from the Actions tab (workflow_dispatch). Takes no options.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {}
            },
            "issue_comment": {
              "description": "Privileged: a comment on an issue or pull request. Anyone who can comment can fire it, so gate jobs with maintainer: true. A gated job needs types: [created] (PF316).",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "issues": {
              "description": "Privileged: issue activity (opened, labeled, \u2026).",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_target": {
              "description": "Privileged, metadata only: labels and comments on pull requests, no checkout. Warns PF311: GitHub blocks this trigger by default in public repositories from 2026-12-02.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                },
                "branches": {
                  "description": "Base branch name patterns.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_review": {
              "description": "Privileged, metadata only (like pull_request_target): GITHUB_SHA is the PR's merge commit, so no checkout.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "pull_request_review_comment": {
              "description": "Privileged, metadata only (like pull_request_target): GITHUB_SHA is the PR's merge commit, so no checkout.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "discussion": {
              "description": "Privileged: discussion activity.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "discussion_comment": {
              "description": "Privileged: a comment on a discussion.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "description": "Activity types to run on, e.g. [created]. Without it, GitHub's default set (which may include edits and deletions).",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "pattern": "\\$\\{\\{"
                    }
                  },
                  "minItems": 1
                }
              }
            }
          }
        },
        "jobs": {
          "description": "Jobs, by name. Lowercase letters, digits and hyphens.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/job"
          }
        },
        "unsafe_run": {
          "description": "Turn off the trust-zone checks for this workflow so privileged jobs may run scripts. Stamped in the generated file's header and flagged as a security-relevant change. Avoid.",
          "type": "boolean"
        }
      }
    },
    "job": {
      "description": "One job. Its zone (unprivileged, feeder or privileged) follows from its trigger, permissions, secrets, environment and what consumes its artifacts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "steps"
      ],
      "properties": {
        "runner": {
          "description": "Runner label (runs-on), e.g. ubuntu-24.04. Feeder and privileged jobs need a standard GitHub-hosted label, or ephemeral_runner: true (PF315).",
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        "ephemeral_runner": {
          "description": "Assert that this job's runner is a fresh machine for every job (a GitHub larger runner, or an ephemeral or just-in-time self-hosted runner). Needed for feeder and privileged jobs on labels that aren't standard GitHub-hosted runners (PF315). Stamped in the generated file.",
          "type": "boolean"
        },
        "needs": {
          "description": "Job or jobs that must finish first.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "if": {
          "description": "When the job runs: a structured condition (no ${{ }} expressions).",
          "$ref": "#/$defs/condition"
        },
        "permissions": {
          "description": "GITHUB_TOKEN scopes. The job gets exactly these plus what generated steps need, and nothing else. Any write scope or id-token makes the job privileged.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "description": "Workflow runs and artifacts.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "artifact-metadata": {
              "description": "Artifact metadata.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "attestations": {
              "description": "Artifact attestations.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "checks": {
              "description": "Check runs and suites.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "code-quality": {
              "description": "Code quality results.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "contents": {
              "description": "Repository contents, commits, tags and releases.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "copilot-requests": {
              "description": "Copilot requests.",
              "enum": [
                "write",
                "none"
              ]
            },
            "deployments": {
              "description": "Deployments.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "discussions": {
              "description": "Discussions.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "id-token": {
              "description": "Request an OIDC token, e.g. for PyPI trusted publishing. Makes the job privileged.",
              "enum": [
                "write",
                "none"
              ]
            },
            "issues": {
              "description": "Issues and their comments and labels.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "packages": {
              "description": "GitHub Packages.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "pages": {
              "description": "GitHub Pages builds.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "pull-requests": {
              "description": "Pull requests and their comments and labels.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "security-events": {
              "description": "Code scanning alerts.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "statuses": {
              "description": "Commit statuses.",
              "enum": [
                "read",
                "write",
                "none"
              ]
            },
            "vulnerability-alerts": {
              "description": "Dependabot alerts.",
              "enum": [
                "read",
                "none"
              ]
            }
          }
        },
        "environment": {
          "description": "GitHub deployment environment, e.g. pypi. Makes the job privileged.",
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        "timeout-minutes": {
          "description": "Cancel the job after this many minutes (1\u2013360).",
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "concurrency": {
          "description": "Run at most one job of this group at a time.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "description": "Concurrency group name.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "cancel-in-progress": {
              "description": "Cancel a running job of the same group when a new one starts.",
              "type": "boolean"
            }
          }
        },
        "steps": {
          "description": "Steps, in order. Each is exactly one of checkout, run, uses or effect.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "produces": {
          "description": "Artifacts this job uploads: name \u2192 path, e.g. { dist: dist/ }. Pinfold generates the upload and records the sha256 digest.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\$\\{\\{"
            }
          }
        },
        "consumes": {
          "description": "Artifacts this job downloads from an earlier job: name \u2192 { from, to }. Pinfold generates the download and checks the digest. The only way a feeder or privileged job may receive artifacts (PF307).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "description": "Name of the job that produces the artifact.",
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "to": {
                "description": "Directory to download it into, e.g. dist/.",
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              }
            }
          }
        }
      }
    },
    "step": {
      "description": "A step: exactly one of checkout, run, uses or effect.",
      "oneOf": [
        {
          "description": "Check out the repository with the pinned actions/checkout.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkout"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "checkout": {
              "description": "Check out the repository. Takes no options. Not allowed in metadata-only jobs.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {}
            }
          }
        },
        {
          "description": "Your own shell script. Not allowed in privileged jobs (PF301).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "run": {
              "description": "Shell script. Event data can't appear here; pass it through env: with a T_ name.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "env": {
              "description": "Environment variables for the script. Values that come from event data (tainted) need names matching T_[A-Z0-9_]+.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "maxLength": 256
              },
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "description": "A third-party action. Pinfold pins it to a commit SHA. Privileged jobs may only use registry actions marked privileged_ok (PF304).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uses"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "uses": {
              "description": "owner/repo@tag or owner/repo/path@tag. No SHAs, branches, docker:// or local actions in privileged jobs.",
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+(/[A-Za-z0-9._/-]+)?@[A-Za-z0-9._/+-]+$",
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "with": {
              "description": "Action inputs. Event data (tainted values) isn't allowed here.",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              },
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
                "maxLength": 256
              }
            }
          }
        },
        {
          "description": "Effect: post a sanitised comment on an issue or pull request.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "body"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "description": "Effect name: comment.",
              "const": "comment"
            },
            "target": {
              "description": "Issue or pull request number, e.g. { context: issue.number }.",
              "$ref": "#/$defs/value"
            },
            "body": {
              "description": "Comment text. {{ name }} placeholders insert contexts, e.g. {{ actor }}. Sanitised: only @{{ actor }} can notify; other mentions and #refs are neutralised; links and size are capped.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "sticky": {
              "description": "Marker name: update the bot's earlier comment with this marker instead of posting a new one.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        {
          "description": "Effect: add labels to an issue or pull request.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "labels",
            "allowed"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "description": "Effect name: add_labels.",
              "const": "add_labels"
            },
            "target": {
              "description": "Issue or pull request number, e.g. { context: issue.number }.",
              "$ref": "#/$defs/value"
            },
            "labels": {
              "description": "Labels: a list, or { from_comment_args: true } to take them from the comment.",
              "$ref": "#/$defs/labels"
            },
            "allowed": {
              "description": "Allowlist: other labels are refused.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "max": {
              "description": "At most this many labels per run (1\u2013100; default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "description": "Effect: remove labels from an issue or pull request.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "target",
            "labels"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "description": "Effect name: remove_labels.",
              "const": "remove_labels"
            },
            "target": {
              "description": "Issue or pull request number, e.g. { context: issue.number }.",
              "$ref": "#/$defs/value"
            },
            "labels": {
              "description": "Labels: a list, or { from_comment_args: true } to take them from the comment.",
              "$ref": "#/$defs/labels"
            },
            "allowed": {
              "description": "Allowlist: other labels are refused.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "max": {
              "description": "At most this many labels per run (1\u2013100; default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "description": "Effect: set a commit status.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "sha",
            "state",
            "context"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "description": "Effect name: commit_status.",
              "const": "commit_status"
            },
            "sha": {
              "description": "Commit to set the status on, e.g. { context: commit.sha }. From event data under a privileged trigger it needs maintainer: true (PF205).",
              "$ref": "#/$defs/value"
            },
            "state": {
              "description": "error, failure, pending or success.",
              "enum": [
                "error",
                "failure",
                "pending",
                "success"
              ]
            },
            "context": {
              "description": "Status name shown on the commit, e.g. ci/docs.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "description": {
              "description": "Short text shown next to the status.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        {
          "description": "Effect: create a GitHub Release.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "tag"
          ],
          "properties": {
            "name": {
              "description": "Display name for the step.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "effect": {
              "description": "Effect name: release.",
              "const": "release"
            },
            "tag": {
              "description": "Tag to release, e.g. { context: ref.name }. Checked against ^[A-Za-z0-9._/-]{1,128}$. From event data under a privileged trigger it needs maintainer: true (PF205).",
              "$ref": "#/$defs/value"
            },
            "files": {
              "description": "Files to attach (glob patterns), e.g. [\"dist/*\"].",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            },
            "generate_notes": {
              "description": "Let GitHub generate release notes.",
              "type": "boolean"
            },
            "draft": {
              "description": "Create the release as a draft.",
              "type": "boolean"
            },
            "prerelease": {
              "description": "Mark the release as a pre-release.",
              "type": "boolean"
            }
          }
        }
      ]
    },
    "value": {
      "description": "A value: a literal, or exactly one of { context: NAME }, { secret: NAME }, { var: NAME } or { output: job.name }.",
      "oneOf": [
        {
          "description": "A literal string, number or boolean.",
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "not": {
            "pattern": "\\$\\{\\{"
          }
        },
        {
          "description": "A typed reference.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "context": {
              "description": "Event or run data. Untainted: pr.number, issue.number, run.id, run.attempt, event.name, pr.author_association, repo.full_name, repo.default_branch, and commit.sha under trusted triggers. Everything else is tainted and may only reach env: (T_ names) or generated steps.",
              "enum": [
                "actor",
                "triggering_actor",
                "commit.sha",
                "comment.body",
                "comment.id",
                "event.name",
                "issue.number",
                "issue.title",
                "issue.body",
                "pr.number",
                "pr.title",
                "pr.body",
                "pr.author_association",
                "pr.head.ref",
                "pr.head.sha",
                "pr.base.ref",
                "ref.name",
                "repo.full_name",
                "repo.default_branch",
                "run.id",
                "run.attempt"
              ]
            },
            "secret": {
              "description": "A repository or environment secret by name. Makes the job privileged.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "var": {
              "description": "A repository or environment variable (vars.NAME).",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            "output": {
              "description": "Another job's output, written job.name, e.g. build.version. Always tainted in a privileged job.",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        }
      ]
    },
    "labels": {
      "description": "Labels: a fixed list, or { from_comment_args: true }.",
      "oneOf": [
        {
          "description": "A fixed list of labels.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\$\\{\\{"
            }
          },
          "minItems": 1
        },
        {
          "description": "Take labels from the words after the command in the comment.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_comment_args"
          ],
          "properties": {
            "from_comment_args": {
              "description": "Take labels from the comment, e.g. \"/label bug docs\". Needs comment.starts_with and maintainer: true in the job's if (PF122).",
              "const": true
            }
          }
        }
      ]
    },
    "condition": {
      "description": "A condition with exactly one key. Combine several with all: or any:.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "event": {
          "description": "Trigger event name or names, e.g. issue_comment.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "branch": {
          "description": "Exact branch name or names (the base branch for pull request events).",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "tag": {
          "description": "Exact tag name or names (tag pushes).",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "label": {
          "description": "Label name or names on the issue or pull request.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "actor": {
          "description": "User name or names. Weak on privileged jobs (PF322): prefer maintainer: true.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "\\$\\{\\{"
                }
              },
              "minItems": 1
            }
          ]
        },
        "association": {
          "description": "Author association(s) on the event. Weaker than maintainer: true.",
          "oneOf": [
            {
              "enum": [
                "COLLABORATOR",
                "CONTRIBUTOR",
                "FIRST_TIMER",
                "FIRST_TIME_CONTRIBUTOR",
                "MANNEQUIN",
                "MEMBER",
                "NONE",
                "OWNER"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "COLLABORATOR",
                  "CONTRIBUTOR",
                  "FIRST_TIMER",
                  "FIRST_TIME_CONTRIBUTOR",
                  "MANNEQUIN",
                  "MEMBER",
                  "NONE",
                  "OWNER"
                ]
              }
            }
          ]
        },
        "status": {
          "description": "Run depending on earlier jobs: success, failure, always or not_cancelled.",
          "enum": [
            "always",
            "failure",
            "not_cancelled",
            "success"
          ]
        },
        "comment": {
          "description": "Match the comment text.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "starts_with"
          ],
          "properties": {
            "starts_with": {
              "description": "The comment starts with this text, e.g. \"/label \".",
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "\\$\\{\\{"
              }
            }
          }
        },
        "maintainer": {
          "description": "Require write, maintain or admin access for the triggering user, checked by a generated first step. Only at the top level of the job's if: all:. Non-maintainers get a neutral skip.",
          "const": true
        },
        "all": {
          "description": "All of these conditions.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "description": "Any of these conditions.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    }
  }
}
